# Zegel Configuration
# Copy this file to .env and adjust values for your environment.
# See FORMAT_SPEC.md for complete documentation.

# Default block size in bytes (default: 65536 = 64 KiB)
ZEGEL_BLOCK_SIZE=65536

# Default classification level (PUBLIC, INTERNAL, CONFIDENTIAL, SECRET, TOP_SECRET)
ZEGEL_DEFAULT_CLASSIFICATION=INTERNAL

# Argon2id parameters for password-derived keys (OWASP 2024 minimums)
ZEGEL_ARGON2_TIME_COST=3
ZEGEL_ARGON2_MEMORY_COST=65536

# RFC 3161 Time Stamp Authority URL (optional)
# ZEGEL_TSA_URL=http://timestamp.digicert.com

# Default key storage directory
# ZEGEL_KEY_DIR=~/.zegel/keys

# Enable anonymous mode by default (no filename/content-type in header)
ZEGEL_ANONYMOUS_MODE=false

# Enable key commitment by default (recommended)
ZEGEL_KEY_COMMITMENT=true

# Enable compression by default
ZEGEL_COMPRESS=false

# Docker-specific settings
# ZEGEL_DATA_DIR=/data
# ZEGEL_LOG_LEVEL=info

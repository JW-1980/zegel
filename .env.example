# Zegel environment variables (improvement #110).
#
# Copy this file to `.env` and edit the values before running
# `docker compose up -d` or deploying via Ansible/Helm/Terraform.
# Every setting documented here has a sensible default — you only
# need to override the ones relevant to your deployment.

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
ZEGEL_PORT=8080
ZEGEL_LOG_LEVEL=info           # trace | debug | info | warn | error

# ---------------------------------------------------------------------------
# Timestamp authority (RFC 3161)
# ---------------------------------------------------------------------------
ZEGEL_TSA_URL=                 # e.g. http://timestamp.digicert.com
ZEGEL_TSA_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Webhook notifications
# ---------------------------------------------------------------------------
ZEGEL_WEBHOOK_URL=             # e.g. https://example.org/zegel-events
ZEGEL_WEBHOOK_SECRET=          # HMAC-SHA256 shared secret

# ---------------------------------------------------------------------------
# MinIO object store (optional, `--profile object-store`)
# ---------------------------------------------------------------------------
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=zegel
MINIO_ROOT_PASSWORD=change-me-before-production

# ---------------------------------------------------------------------------
# Storage directories (mounted into the container)
# ---------------------------------------------------------------------------
ZEGEL_DATA_DIR=/var/lib/zegel
ZEGEL_KEY_DIR=/var/lib/zegel/keys

# ---------------------------------------------------------------------------
# Default sealing options
# ---------------------------------------------------------------------------
ZEGEL_DEFAULT_BLOCK_SIZE=65536
ZEGEL_DEFAULT_CLASSIFICATION=INTERNAL
ZEGEL_DEFAULT_COMPRESSION=true

# ---------------------------------------------------------------------------
# Opt-in telemetry (local only — nothing is transmitted)
# ---------------------------------------------------------------------------
ZEGEL_ANALYTICS_ENABLED=false
ZEGEL_CRASH_REPORTING_ENABLED=false
